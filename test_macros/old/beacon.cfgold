#####################################################################
#  Beacon Probe
#####################################################################

[beacon]
serial: /dev/serial/by-id/usb-Beacon_Beacon_RevH_25A490435157355957202020FF102C20-if00
speed: 20 #30
lift_speed: 50
backlash_comp: 0.00611
x_offset: 0.
y_offset: 23.8
trigger_distance: 2.
trigger_dive_threshold: 1.
trigger_hysteresis: 0.006
z_settling_time: 8 #5
cal_nozzle_z: 0.1
cal_floor: 0.2
cal_ceil: 5.
cal_speed: 1.
cal_move_speed: 10.
default_model_name: default
mesh_main_direction: x
mesh_overscan: 2 #-1
mesh_cluster_size: 2 #1
mesh_runs: 2
zero_reference_cluster_size: 1.
accel_scale: 16g
accel_axes_map: x, y, z
default_probe_method: proximity #contact
contact_max_hotend_temperature: 280 # increase to enable hot contacting
contact_sensitivity: 1
contact_latency_min: 0
home_xy_position: 175, 175
home_z_hop: 5
home_z_hop_speed: 50 #30
home_xy_move_speed: 400 #80
home_y_before_x: True #False
home_method: proximity #contact
home_method_when_homed: proximity #contact # defaults to `home_method` value
home_autocalibrate: unhomed #always|unhomed|never

# new autocalibration config options
autocal_speed: 3
autocal_accel: 100
autocal_retract_dist: 2
autocal_retract_speed: 10
autocal_sample_count: 3
autocal_tolerance: 0.008
autocal_max_retries: 5 #3