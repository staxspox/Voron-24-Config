[gcode_macro PRINT_START]
gcode:
  # This part fetches data from your slicer
  {% set target_bed = params.BED|int %}
  {% set target_extruder = params.EXTRUDER|int %}
  {% set target_chamber = params.CHAMBER|default(0)|int %}  # Zmiana: default=0 (użyj rdzenia default)
  {% set x_wait = printer.toolhead.axis_maximum.x|float / 2 %}
  {% set y_wait = printer.toolhead.axis_maximum.y|float / 2 %}
 
  # Calculate dynamic soak time and format it
  {% set soak_seconds = [0, (target_bed - 60) * 10]|max %}
  {% set soak_seconds = [soak_seconds, 300]|min %}
  {% set soak_min = soak_seconds // 60 %}
  {% set soak_sec = soak_seconds % 60 %}
  {% set soak_time_msg = "{0}min {1}sek".format(soak_min, soak_sec) if soak_seconds > 0 else "0sek" %}
  {% set soak_time_ms = soak_seconds * 1000 %}
  M117 DEBUG: {target_bed}C -> {soak_time_msg}
  # Main macro
  LED_ON
  PREFLIGHT_CHECK
  SET_DISPLAY_TEXT MSG="Preheating..."
  STATUS_HEATING
  M117 Preheating...
  M104 S150 # set initial hot end temp to 150 to avoid oozing. dont wait
  M190 S{target_bed}
## Uncomment for bed mesh (1 of 2 for bed mesh) # Clear old saved bed mesh (if any)
  BED_MESH_CLEAR
## Uncomment for Beacon Contact (1 of 4 for beacon contact)
  SET_GCODE_OFFSET Z=0 # Set offset to 0
  GET_CURRENT_SKEW
 
# Home and prepare
  STATUS_HOMING
  G28 METHOD=PROXIMITY # Home using proximity to get close to avoid the slow creep down when z is high
  M400
  G90 # Absolute position
  {% set chamber_temp = printer["temperature_sensor chamber"].temperature|default(0)|float %}
# Zawsze czekaj na komorę, jeśli jest wymagana wyższa temperatura niż aktualna
  {% if target_chamber > (chamber_temp + 3) %}
    SET_DISPLAY_TEXT MSG="Heating bed + chamber {target_chamber}°C"
    STATUS_HEATING
    PARK_NOZZLE # G1 X{x_wait} Y{y_wait} Z15 F9000
    M190 S{target_bed} # Grzej łóżko
    M117 Waiting for chamber {target_chamber}°C
    SET_DISPLAY_TEXT MSG="Chamber → {target_chamber}°C"
    TEMPERATURE_WAIT SENSOR="temperature_sensor chamber" MINIMUM={target_chamber}
  {% else %}
    SET_DISPLAY_TEXT MSG="Bed: {target_bed}°C"
    M190 S{target_bed}
    {% set chamber_temp = printer["temperature_sensor chamber"].temperature|default(0)|float %}
    {% if target_bed > 60 %}
      {% set soak_seconds = [0, (target_bed - 60) * 10]|max %}
      {% set soak_seconds = [soak_seconds, 300]|min %}
      {% set soak_needed = (chamber_temp <= 50) and (soak_seconds > 0) %}
      {% if soak_needed %}
        {% set soak_min = soak_seconds // 60 %}
        {% set soak_sec = soak_seconds % 60 %}
        {% set soak_time_msg = "{0}min {1}sek".format(soak_min, soak_sec) %}
        {% set soak_time_ms = soak_seconds * 1000 %}
        SET_DISPLAY_TEXT MSG="Soak: {soak_time_msg}"
        M117 Soak: {soak_time_msg}
        G4 P{soak_time_ms}
      {% else %}
        {% if chamber_temp > 50 %}
          SET_DISPLAY_TEXT MSG="Chamber hot ({chamber_temp|round(0)}°C) → soak skipped"
          M117 Soak skipped
        {% else %}
          SET_DISPLAY_TEXT MSG="No soak needed"
          M117 No soak
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
# SET_DISPLAY_TEXT MSG="Soak: {soak_time_msg}"
# M117 Soak: {soak_time_msg}
# G4 P{soak_time_ms}
# {% endif %}
# {% endif %}
   
    SET_DISPLAY_TEXT MSG="Nozzle Wipe" # Display info on display
    NOZZLE_WIPE
    #KOMB
## Uncomment for Beacon contact (2 of 4 for beacon contact)
    G28 Z METHOD=CONTACT CALIBRATE=1 # Calibrate z offset and beacon model
## Uncomment for V2.4 (Quad Gantry Level AKA QGL)
    SET_DISPLAY_TEXT MSG="Leveling" # Display info on display
    STATUS_LEVELING # Set LEDs to leveling-mode
    QUAD_GANTRY_LEVEL # Level the printer via QGL
    G28 Z METHOD=PROXIMITY
    M400
## Uncomment for bed mesh (2 of 2 for bed mesh)
    SET_DISPLAY_TEXT MSG="Bed mesh" # Display info on display
    STATUS_MESHING # Set LEDs to bed mesh-mode
    BED_MESH_CALIBRATE ADAPTIVE=1 RUNS=2 # Start the bed mesh in scan mode (add ADAPTIVE=1) for adaptive bed mesh
    M400
## Uncomment for Beacon Contact (3 of 4 for beacon contact)
    G28 Z METHOD=CONTACT CALIBRATE=0 # Home Z again after cleaning #CALIBRATE=1
    M400
## Heat up the hotend up to target via data from slicer
    SET_DISPLAY_TEXT MSG="Hotend: {target_extruder}c" # Display info on display
    G1 X{x_wait} Y{y_wait} Z15 F9000 # Go to center of the bed
    STATUS_HEATING # Set LEDs to heating-mode
    M107 # Turn off partcooling fan
    M109 S{target_extruder} # Heat the hotend to set temp
       
## HOT NOZZLE FINAL CALIBRATION - Before Print!
    #SET_DISPLAY_TEXT MSG="Final Z-offset calibration"
    #G4 P60000 # Pauza 60 sekund (opcjonalnie)
    #NOZZLE_WIPE # Nozzle Cleaning
    #G28 Z METHOD=CONTACT CALIBRATE=0 # ✅ OSTATECZNY zapis offsetu na docelowej temp! #CALIBRATE=0
    #M400
## Uncomment for Beacon Contact (4 of 4 for beacon contact)
    _SET_MPC_MATERIAL MATERIAL={params.MATERIAL}
    #CONFIGURE_FILAMENT_OFFSET FILAMENT_TYPE={FILAMENT_TYPE} # We set our offset based on filament type and a thermal expansion
    #SET_GCODE_OFFSET Z=0.065 # add a little offset for hotend thermal expansion
                                                             # needs fine tuning, long meltzones require more
## ✅ KOMPENSACJA TERMICZNA - ZASTĄPIENIE RĘCZNEGO OFFSETU
    #CONFIGURE_FILAMENT_OFFSET FILAMENT_TYPE={FILAMENT_TYPE} # We set our offset based on filament type and a thermal expansion
    #{% if printer.configfile.settings.beacon is defined %}
    # _BEACON_SET_NOZZLE_TEMP_OFFSET # ✅ Automatyczny offset z rozszerzalności termicznej
    #{% endif %}
## Get ready to print by doing a primeline and updating the LEDs
    SET_DISPLAY_TEXT MSG="Printer goes brr..." # Display info on display
    STATUS_PRINTING # Set LEDs to printing-mode
## PURGE LINE
    G91 # Incremental positioning
    #LINE_PURGE # Adaptive Purge Line
    PRIME_LINE
    #ZIGZAG
    #SQUIGGLY_PURGE # Wave Line
    #
    G90 # Absolute position